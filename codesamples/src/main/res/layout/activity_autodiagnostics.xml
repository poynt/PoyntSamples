<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Button
            android:id="@+id/getHardwareInfoButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="#777777"
            android:gravity="center"
            android:text="Get Hardware Info"
            android:textSize="18sp" />

        <Button
            android:id="@+id/getPrinterInfoButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="#777777"
            android:gravity="center"
            android:text="Get Printer Info"
            android:textSize="18sp" />

        <Button
            android:id="@+id/getDockInfoButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="#777777"
            android:gravity="center"
            android:text="Get Dock Info"
            android:textSize="18sp" />

        <Button
            android:id="@+id/subscribeButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="#777777"
            android:gravity="center"
            android:text="Subscribe on changes"
            android:textSize="18sp" />

        <Button
            android:id="@+id/unsubscribeButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="#777777"
            android:gravity="center"
            android:text="Unsubscribe"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/infoTextView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:gravity="center_horizontal"
            android:text="Info will be here..."
            android:textColor="#000000"
            android:textSize="20sp" />

    </LinearLayout>

</ScrollView>
